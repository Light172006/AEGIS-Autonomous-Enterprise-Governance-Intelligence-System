AEGIS_DATA_DIR=data
AEGIS_VECTOR_DB_DIR=vector_db/chroma
AEGIS_COLLECTION_NAME=aegis_p102
AEGIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Select the local provider for the on-premise path, or use openrouter for development.
AEGIS_LLM_PROVIDER=ollama
# LLM_PROVIDER is also accepted as a provider-selection alias.
# LLM_PROVIDER=ollama
AEGIS_LLM_MODEL=openai/gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENROUTER_API_KEY=

# Orchestrator (Qwen3 tool-calling) — falls back to OLLAMA_MODEL if unset
ORCHESTRATOR_MODEL=llama3
ORCHESTRATOR_MAX_AGENT_CALLS=3
ORCHESTRATOR_CONFIDENCE_THRESHOLD=0.35

# ─── Backend API ───
AEGIS_DATABASE_URL=sqlite:///aegis.db
AEGIS_JWT_SECRET=change-me-to-a-random-secret
AEGIS_JWT_EXPIRE_MINUTES=480
AEGIS_ADMIN_PASSWORD=aegis-admin-2024
AEGIS_CORS_ORIGINS=http://localhost:3000
AEGIS_UPLOAD_DIR=data/uploads
