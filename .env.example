AEGIS_DATA_DIR=data
AEGIS_VECTOR_DB_DIR=vector_db/chroma
AEGIS_COLLECTION_NAME=aegis_p102
AEGIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
